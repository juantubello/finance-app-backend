NODE_ENV=production
PORT=3000
DB_PATH=./data/finance.db

# Google Sheets API (formato GS_* o GOOGLE_*)
GS_SPREADSHEET_ID=your-spreadsheet-id-here
GS_CLIENT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
GS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# Alternativamente puedes usar GOOGLE_* en lugar de GS_*
# GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
# GOOGLE_CLIENT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
